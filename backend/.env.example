# SQLite by default; swap to PostgreSQL later e.g. postgresql+psycopg://user:pass@localhost:5432/carbontrace
DATABASE_URL=sqlite:///./carbontrace.db

# Required JWT signing secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=replace-with-random-64-char-hex-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage & upload limits (10 MB max; pdf, xlsx, csv, png, jpg allowed)
UPLOAD_DIR=./uploads
SAMPLE_DATA_DIR=./sample_data
MAX_UPLOAD_BYTES=10485760

# Password for the seeded fictional demo user (demo@demofasteners.in)
DEMO_USER_PASSWORD=replace-with-demo-password

# Google GenAI (Gemini) — leave GEMINI_API_KEY empty to use cached sample extractions cleanly
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Orchestrator & APScheduler follow-up settings (seconds in demo mode)
DEMO_MODE=true
FOLLOWUP_INTERVAL_SECONDS=12
OUTREACH_MAX_TRIES=3
