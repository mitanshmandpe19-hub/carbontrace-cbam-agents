# CarbonTrace Backend Environment Variables

# Port for the API server (Render sets PORT automatically)
PORT=8000

# Database URL: sqlite:///./carbontrace.db for local/SQLite, or postgresql+psycopg://user:pass@host/dbname for PostgreSQL
DATABASE_URL=sqlite:///./carbontrace.db

# Secret key for signing JWT tokens (use a long random 32+ character string)
JWT_SECRET=change_me_long_random_jwt_secret_key_at_least_32_characters

# Demo mode and demo user password
DEMO_MODE=true
DEMO_USER_PASSWORD=demo-fasteners-2026

# Allowed CORS origins (comma-separated URLs, or * for any origin)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API key (get one from https://aistudio.google.com)
# If omitted or left as placeholder, the system runs in deterministic fallback mode with cached extractions
GEMINI_API_KEY=your_gemini_key_here

# Recommended Gemini model for document extraction and outreach
GEMINI_MODEL=gemini-2.5-flash

# Upload and sample data storage directories
UPLOAD_DIR=./uploads
SAMPLE_DATA_DIR=./sample_data

# Background scheduler interval in seconds for outreach simulation sweeps
FOLLOWUP_INTERVAL_SECONDS=12
