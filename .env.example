# Set to "false" to connect the Next.js frontend to the FastAPI backend.
# Keep "true" to run the frontend offline with in-browser mock sample data.
NEXT_PUBLIC_USE_MOCK=false

# FastAPI backend base URL (no trailing slash).
# Local default: http://localhost:8000 (or Render / Railway URL in production).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
