# CarbonTrace Frontend Environment Variables
# IMPORTANT: All NEXT_PUBLIC_ variables are bundled into client-side JavaScript and are
# publicly visible in the browser. NEVER store private secrets, API keys, or passwords here.

# Backend API base URL without trailing slash (e.g. http://localhost:8000 or https://your-backend.onrender.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set to "false" to use the real FastAPI backend, or "true" to run with in-memory mock data
NEXT_PUBLIC_USE_MOCK=false
